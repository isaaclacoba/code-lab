@inject CompilerService Compiler
@inject IJSRuntime JS
@implements IDisposable
@using CodeLab.Host

@* Headless bridge: lets any page run C# through this app's in-browser compiler
   via postMessage. Rendered only when the app is loaded with ?runner=1. *@

@code {
    private DotNetObjectReference<RunnerBridge>? _ref;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Compiler.InitAsync();
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("codeRunnerHost.init", _ref);
    }

    [JSInvokable]
    public async Task<RunResult> Run(string code)
    {
        var result = await Compiler.RunAsync(code ?? "");
        var errors = result.Errors
            .Select(e => new RunError(e.Line, e.Friendly, e.Raw, e.Why))
            .ToList();
        var warnings = result.Warnings
            .Select(e => new RunError(e.Line, e.Friendly, e.Raw, e.Why))
            .ToList();
        return new RunResult(result.Compiled, result.Output, result.RuntimeError, errors, warnings);
    }

    [JSInvokable]
    public async Task<TraceResponse> Trace(string code)
    {
        await Compiler.InitAsync();
        var result = Tracer.Trace(code ?? "", Compiler.References);
        var errors = result.Errors
            .Select(e => new RunError(e.Line, e.Friendly, e.Raw, e.Why))
            .ToList();
        return new TraceResponse(result.Compiled, result.TraceJson, result.RuntimeError, errors);
    }

    public void Dispose() => _ref?.Dispose();

    public record RunError(int? Line, string? Friendly, string Raw, string? Why);

    public record RunResult(bool Compiled, string Output, string? RuntimeError, List<RunError> Errors, List<RunError> Warnings);

    public record TraceResponse(bool Compiled, string? TraceJson, string? RuntimeError, List<RunError> Errors);
}
